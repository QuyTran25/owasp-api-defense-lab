--- a/VAmPI/api_views/users.py
+++ b/VAmPI/api_views/users.py
@@ -45,6 +45,15 @@ def get_authenticated_user(auth_header):
     if not user:
         return None, unauthorized_response()
 
+    # A token remains cryptographically valid until exp, so signature checking
+    # alone cannot revoke it after a password change. Reject a missing,
+    # malformed, or stale version using the server-side account record.
+    token_version = payload.get('token_version')
+    if isinstance(token_version, bool) or not isinstance(token_version, int):
+        return None, unauthorized_response()
+    if token_version != user.token_version:
+        return None, unauthorized_response()
+
     return user, None
 
 
@@ -218,6 +227,10 @@ def update_password(username):
         return Response(error_message_helper("Malformed Data"), 400, mimetype="application/json")
 
     user.password = request_data.get('password')
+    # Revoke every previously issued access token for this user. The request
+    # itself was authenticated before the increment; subsequent requests must
+    # authenticate again and receive a JWT carrying the new version.
+    user.token_version += 1
     db.session.commit()
     responseObject = {
         'status': 'success',
diff --git a/VAmPI/config.py b/VAmPI/config.py
index c64ca8e..f9be1c6 100644
--- a/VAmPI/config.py
+++ b/VAmPI/config.py
@@ -3,6 +3,7 @@ import connexion
 from flask import jsonify
 from flask_sqlalchemy import SQLAlchemy
 from connexion.exceptions import ProblemException
+from sqlalchemy import inspect, text
 
 vuln_app = connexion.App(__name__, specification_dir='./openapi_specs')
 
@@ -21,6 +22,28 @@ vuln_app.app.config['JWT_ISSUER'] = os.getenv('VAMPI_JWT_ISSUER', 'vampi-state-b
 # start the db
 db = SQLAlchemy(vuln_app.app)
 
+
+def migrate_token_version_column():
+    """Apply the small, idempotent SQLite migration required by State B.
+
+    State B keeps the existing lab database in a bind mount. SQLAlchemy does
+    not add new columns to an existing SQLite table automatically, so create
+    ``token_version`` once without dropping user data.
+    """
+    with vuln_app.app.app_context():
+        inspector = inspect(db.engine)
+        if 'users' not in inspector.get_table_names():
+            return
+        columns = {column['name'] for column in inspector.get_columns('users')}
+        if 'token_version' not in columns:
+            db.session.execute(text(
+                'ALTER TABLE users ADD COLUMN token_version INTEGER NOT NULL DEFAULT 0'
+            ))
+            db.session.commit()
+
+
+migrate_token_version_column()
+
 def custom_problem_handler(error):
